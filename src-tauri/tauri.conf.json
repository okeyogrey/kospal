{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOSPAL",
  "version": "0.1.0",
  "identifier": "com.kospal.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:serve",
    "devUrl": "http://127.0.0.1:8000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "KOSPAL",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
