APP_NAME=KOSPAL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# desktop (default) | web — desktop is local-first SQLite / Tauri
KOSPAL_DEPLOYMENT_MODE=desktop
KOSPAL_APP_VERSION=0.1.0
KOSPAL_LICENSE_EDITION=enterprise
KOSPAL_LICENSE_TRIAL_DAYS=30
# Optional HMAC secret for signed license keys (defaults to APP_KEY)
# KOSPAL_LICENSE_SECRET=
# Optional remote license activation endpoint
# KOSPAL_LICENSE_SERVER_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite when unset
# Optional SQLite tuning (also applied by DatabaseToolkit)
# KOSPAL_SQLITE_JOURNAL_MODE=WAL
# KOSPAL_SQLITE_SYNCHRONOUS=NORMAL
# KOSPAL_SQLITE_BUSY_TIMEOUT=5000
# Future MySQL / PostgreSQL (web or migrated desktop):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kospal
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CONNECTION=pgsql
# DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
